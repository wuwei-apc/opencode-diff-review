{
  "name": "opencode-diff-review",
  "version": "1.0.0",
  "description": "Per-file AI change review for OpenCode v2: side-by-side diff, block/line/file/session revert.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-v2",
    "diff",
    "revert",
    "snapshot",
    "code-review"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/wuwei-apc/opencode-diff-review.git"
  },
  "bugs": {
    "url": "https://github.com/wuwei-apc/opencode-diff-review/issues"
  },
  "homepage": "https://github.com/wuwei-apc/opencode-diff-review#readme",
  "exports": {
    ".": "./index.ts",
    "./tui": "./tui.ts",
    "./types": "./src/types.ts"
  },
  "files": [
    "index.ts",
    "tui.ts",
    "src",
    "README.md",
    "教程.md",
    "使用文档.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "bun test",
    "smoke": "bun run scripts/smoke.ts",
    "typecheck": "tsc --noEmit",
    "check": "bun test && bun run scripts/smoke.ts && tsc --noEmit",
    "package": "npm pack --pack-destination dist"
  },
  "dependencies": {
    "@opencode/plugin": ">=2.0.0"
  },
  "devDependencies": {
    "@opentui/solid": "0.6.6",
    "@types/node": "^22.10.0",
    "solid-js": "1.9.12",
    "typescript": "^5.7.0"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
